<MudContainer MaxWidth="MaxWidth.Small" Class="text-center py-8">
    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size: 4rem;" />
    <MudText Typo="Typo.h6" Color="Color.Error" Class="mt-3 mb-1">
        @Title
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @Message
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="OnRetry">
        Reintentar
    </MudButton>
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = "Algo salió mal";
    [Parameter] public string Message { get; set; } = "Ha ocurrido un error inesperado.";
    [Parameter] public EventCallback OnRetry { get; set; }
}