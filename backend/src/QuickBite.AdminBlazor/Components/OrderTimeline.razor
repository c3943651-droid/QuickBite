<div class="order-timeline">
    @foreach (var entry in Entries)
    {
        <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
                <MudText Typo="Typo.body2" Class="fw-bold">@entry.Label</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Timestamp</MudText>
                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Detail</MudText>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<TimelineEntry> Entries { get; set; } = new();

    public sealed record TimelineEntry(string Label, string Timestamp, string? Detail = null);
}