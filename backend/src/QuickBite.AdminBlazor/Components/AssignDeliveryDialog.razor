@using QuickBite.AdminBlazor.Models.Orders
@using QuickBite.AdminBlazor.Services

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Asignar repartidor al pedido "@OrderNumero"
        </MudText>

        @if (IsLoading)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
        }
        else if (Repartidores.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                No hay repartidores disponibles en este momento.
            </MudAlert>
        }
        else
        {
            <MudSelect T="DeliveryPersonItem"
                       @bind-Value="SelectedDelivery"
                       Label="Repartidor disponible"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var repartidor in Repartidores)
                {
                    <MudSelectItem T="DeliveryPersonItem" Value="repartidor">
                        @repartidor.Nombre @(string.IsNullOrWhiteSpace(repartidor.Vehiculo) ? "" : $"· {repartidor.Vehiculo}") @(repartidor.EntregasCompletadas is > 0 ? $"· {repartidor.EntregasCompletadas} entregas" : "")
                    </MudSelectItem>
                }
            </MudSelect>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@Error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="IsSaving || SelectedDelivery is null"
                   OnClick="SaveAsync">
            Asignar
        </MudButton>
    </DialogActions>
</MudDialog>