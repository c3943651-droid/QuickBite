@using QuickBite.AdminBlazor.Models.Catalog
@using QuickBite.AdminBlazor.Services

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Ajustar el stock de "@ProductName"
        </MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2">
                    Stock actual: <strong>@(CurrentStock?.ToString() ?? "—")</strong>
                </MudText>
            </MudItem>
        </MudGrid>
        <MudInput T="int"
                  @bind-Value="NuevoStock"
                  Label="Nuevo stock"
                  InputType="InputType.Number"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense" />
        <MudTextField T="string"
                      @bind-Value="Motivo"
                      Label="Motivo (opcional)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-4" />
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@Error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsSaving" OnClick="SaveAsync">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>