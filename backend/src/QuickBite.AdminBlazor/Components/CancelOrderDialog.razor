@using QuickBite.AdminBlazor.Services

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Cancelar el pedido "@OrderNumero"
        </MudText>
        <MudTextField T="string"
                      @bind-Value="Motivo"
                      Label="Motivo de cancelación"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@Error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   Disabled="IsSaving || string.IsNullOrWhiteSpace(Motivo)"
                   OnClick="SaveAsync">
            Cancelar pedido
        </MudButton>
    </DialogActions>
</MudDialog>