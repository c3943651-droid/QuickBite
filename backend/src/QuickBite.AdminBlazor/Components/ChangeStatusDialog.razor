@using QuickBite.AdminBlazor.Models.Orders
@using QuickBite.AdminBlazor.Services

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Cambiar el estado del pedido "@OrderNumero"
        </MudText>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2">
                    Estado actual: <MudChip T="string" Size="Size.Small" Color="OrderStatusUi.Color(CurrentEstado)">@OrderStatusUi.Display(CurrentEstado)</MudChip>
                </MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.body2">
                    Nuevo estado: <MudChip T="string" Size="Size.Small" Color="OrderStatusUi.Color(TargetEstado)">@OrderStatusUi.Display(TargetEstado)</MudChip>
                </MudText>
            </MudItem>
        </MudGrid>
        <MudTextField T="string"
                      @bind-Value="Comentario"
                      Label="Comentario (opcional)"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-4" />
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@Error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="IsSaving"
                   OnClick="SaveAsync">
            Confirmar cambio
        </MudButton>
    </DialogActions>
</MudDialog>