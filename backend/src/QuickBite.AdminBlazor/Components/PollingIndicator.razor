@if (Active)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3 polling-indicator">
        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" Class="mr-2" />
        Actualizando...
    </MudAlert>
}

@code {
    [Parameter] public bool Active { get; set; }
}