<MudContainer MaxWidth="MaxWidth.Small" Class="text-center py-8">
    <MudIcon Icon="@Icons.Material.Filled.Inbox" Color="Color.Secondary" Style="font-size: 4rem;" />
    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3 mb-1">
        @Title
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        @Message
    </MudText>
    @if (ActionText is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   OnClick="OnAction">
            @ActionText
        </MudButton>
    }
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = "Sin datos";
    [Parameter] public string Message { get; set; } = "No hay elementos para mostrar.";
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}