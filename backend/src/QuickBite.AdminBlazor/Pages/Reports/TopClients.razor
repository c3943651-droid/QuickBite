@page "/reports/top-clients"
@using QuickBite.AdminBlazor.Models.Reports

<PageTitle>Clientes frecuentes — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Clientes frecuentes</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ranking de clientes por actividad y gasto</MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudSelect T="int" Label="Límite" Value="_limite" ValueChanged="OnLimitChangedAsync" Variant="Variant.Outlined" Dense="true" Class="report-limit-select">
                @foreach (var opcion in ReportLimits.Available)
                {
                    <MudSelectItem T="int" Value="@opcion">@opcion</MudSelectItem>
                }
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadDataAsync" Disabled="IsLoading || IsExporting" Class="refresh-top-clients" />
        </div>
    </div>

    @if (IsLoading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="350px" Class="rounded-lg" />
    }
    else if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@Error</MudAlert>
    }
    else if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sin datos para el ranking.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 rounded-lg">
            <div class="d-flex align-center justify-space-between mb-4">
                <MudText Typo="Typo.h6" Class="fw-bold">Detalle del ranking</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsvAsync" Disabled="IsExporting" Class="export-top-clients">
                    Exportar CSV
                </MudButton>
            </div>

            <MudSimpleTable Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Email</th>
                        <th>Total pedidos</th>
                        <th>Gasto total</th>
                        <th>Gasto promedio</th>
                        <th>Último pedido</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.Nombre</td>
                            <td>@row.Email</td>
                            <td>@row.TotalPedidos</td>
                            <td>$@row.GastoTotal.ToString("N2")</td>
                            <td>$@row.GastoPromedio.ToString("N2")</td>
                            <td>@FormatFecha(row.UltimoPedido)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
</MudContainer>