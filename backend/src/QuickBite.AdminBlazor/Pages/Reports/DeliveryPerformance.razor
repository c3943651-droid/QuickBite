@page "/reports/delivery-performance"
@using QuickBite.AdminBlazor.Models.Reports

<PageTitle>Rendimiento de repartidores — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Rendimiento de repartidores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Entregas, asignaciones y tiempos por repartidor</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadDataAsync" Disabled="IsLoading || IsExporting" Class="refresh-delivery-performance" />
    </div>

    @if (IsLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 2; i++)
            {
                <MudItem xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@Error</MudAlert>
    }
    else if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sin datos de rendimiento para mostrar.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 rounded-lg mb-6">
            <MudText Typo="Typo.h6" Class="fw-bold mb-4">Comparativa de entregas</MudText>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@ChartSeries" XAxisLabels="@ChartLabels" Width="100%" Height="300px" />
        </MudPaper>

        <MudPaper Elevation="3" Class="pa-4 rounded-lg">
            <div class="d-flex align-center justify-space-between mb-4">
                <MudText Typo="Typo.h6" Class="fw-bold">Detalle por repartidor</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsvAsync" Disabled="IsExporting" Class="export-delivery-performance">
                    Exportar CSV
                </MudButton>
            </div>

            <MudSimpleTable Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Repartidor</th>
                        <th>Entregas completadas</th>
                        <th>Pedidos asignados</th>
                        <th>Minutos promedio</th>
                        <th>Cancelaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.Nombre</td>
                            <td>@row.EntregasCompletadas</td>
                            <td>@row.PedidosAsignados</td>
                            <td>@row.MinutosPromedioEntrega.ToString("0.#") min</td>
                            <td>@row.Cancelaciones</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
</MudContainer>