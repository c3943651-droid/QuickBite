@page "/reports/top-products"
@using QuickBite.AdminBlazor.Models.Reports

<PageTitle>Productos más vendidos — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Productos más vendidos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Ranking de productos por unidades e ingresos</MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudSelect T="int" Label="Límite" Value="_limite" ValueChanged="OnLimitChangedAsync" Variant="Variant.Outlined" Dense="true" Class="report-limit-select">
                @foreach (var opcion in ReportLimits.Available)
                {
                    <MudSelectItem T="int" Value="@opcion">@opcion</MudSelectItem>
                }
            </MudSelect>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadDataAsync" Disabled="IsLoading || IsExporting" Class="refresh-top-products" />
        </div>
    </div>

    @if (IsLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 2; i++)
            {
                <MudItem xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@Error</MudAlert>
    }
    else if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Sin datos para el ranking.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 rounded-lg mb-6">
            <MudText Typo="Typo.h6" Class="fw-bold mb-4">Top productos</MudText>
            <MudChart ChartType="ChartType.Bar" ChartSeries="@ChartSeries" XAxisLabels="@ChartLabels" Width="100%" Height="300px" />
        </MudPaper>

        <MudPaper Elevation="3" Class="pa-4 rounded-lg">
            <div class="d-flex align-center justify-space-between mb-4">
                <MudText Typo="Typo.h6" Class="fw-bold">Detalle del ranking</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsvAsync" Disabled="IsExporting" Class="export-top-products">
                    Exportar CSV
                </MudButton>
            </div>

            <MudSimpleTable Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Unidades vendidas</th>
                        <th>Ingresos generados</th>
                        <th>Nº pedidos</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.NombreProducto</td>
                            <td>@row.UnidadesVendidas</td>
                            <td>$@row.IngresosGenerados.ToString("N2")</td>
                            <td>@row.NumeroPedidos</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
</MudContainer>