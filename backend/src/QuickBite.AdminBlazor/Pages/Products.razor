@page "/products"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Catalog
@using QuickBite.AdminBlazor.Services

<PageTitle>Productos — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Productos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Catalogo y disponibilidad de la sucursal</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToCreate">
            Nuevo producto
        </MudButton>
    </div>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string"
                              Value="_search"
                              ValueChanged="OnSearchChangedAsync"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Buscar por nombre..."
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="Guid?"
                           Value="_categoriaId"
                           ValueChanged="OnCategoryChangedAsync"
                           Label="Categoría"
                           Placeholder="Todas"
                           Clearable="true">
                    @foreach (var categoria in Categorias)
                    {
                        <MudSelectItem T="Guid?" Value="@(categoria.Id)">@categoria.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string"
                           Value="_disponible"
                           ValueChanged="OnAvailabilityChangedAsync"
                           Label="Disponibilidad">
                    <MudSelectItem T="string" Value="@("todos")">Todas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("si")">Solo disponibles</MudSelectItem>
                    <MudSelectItem T="string" Value="@("no")">No disponibles</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        <div class="d-flex align-center justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FilterAlt"
                       OnClick="ApplyFiltersAsync">
                Aplicar filtros
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       aria-label="Exportar CSV"
                       OnClick="ExportCsvAsync"
                       Disabled="IsExporting">
                Exportar CSV
            </MudButton>
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg">
        <MudDataGrid T="ProductListItem"
                     @ref="_grid"
                     ServerData="LoadServerData"
                     RowsPerPage="10"
                     Hover="true"
                     Striped="true"
                     Dense="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de productos</MudText>
            </ToolBarContent>
            <Columns>
                <TemplateColumn T="ProductListItem" Title="Nombre">
                    <CellTemplate>
                        <div class="d-flex align-center">
                            <MudAvatar Size="Size.Small" Class="mr-3">
                                @if (!string.IsNullOrEmpty(context.Item.ImagenUrl))
                                {
                                    <MudImage Src="@context.Item.ImagenUrl" ObjectFit="ObjectFit.Cover" Height="40" Width="40" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Small" />
                                }
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body1" Class="fw-bold">@context.Item.Nombre</MudText>
                                @if (context.Item.Descripcion is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Descripcion</MudText>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductListItem" Title="Categoría">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.Categoria?.Nombre ?? "—")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductListItem" Title="Precio">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="fw-bold">@($"{context.Item.Precio:C}")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductListItem" Title="Disponible">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@(context.Item.Disponible ? Color.Success : Color.Error)">
                            @(context.Item.Disponible ? "Sí" : "No")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ProductListItem" Title="Acciones" HeaderClass="text-right">
                    <CellTemplate>
                        <div class="d-flex align-center justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           title="Editar"
                                           aria-label="@($"Editar {context.Item.Nombre}")"
                                           OnClick="() => GoToEdit(context.Item.Id)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Inventory"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           title="Ajustar stock"
                                           aria-label="@($"Ajustar stock {context.Item.Nombre}")"
                                           OnClick="() => OpenAdjustStockDialogAsync(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.History"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           title="Historial de precios"
                                           aria-label="@($"Historial {context.Item.Nombre}")"
                                           OnClick="() => GoToPriceHistory(context.Item.Id)" />
                            <MudIconButton Icon="@(context.Item.Disponible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Color="@(context.Item.Disponible ? Color.Warning : Color.Success)"
                                           Size="Size.Small"
                                           title="@(context.Item.Disponible ? "Marcar no disponible" : "Marcar disponible")"
                                           aria-label="@($"Toggle disponibilidad {context.Item.Nombre}")"
                                           OnClick="() => ToggleDisponibleAsync(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           title="Eliminar"
                                           aria-label="@($"Eliminar {context.Item.Nombre}")"
                                           OnClick="() => EliminarAsync(context.Item)" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-8">
                    No hay productos que coincidan con los filtros.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>