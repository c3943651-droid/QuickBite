@page "/offline"
@inject NavigationManager Navigation

<PageTitle>Sin conexión — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center min-vh-80 py-12">
    <MudIcon Icon="@Icons.Material.Filled.WifiOff" Color="Color.Primary" Style="font-size: 6rem;" Class="mb-4" />
    <MudText Typo="Typo.h3" Color="Color.Primary" Align="Align.Center" Class="fw-bold mb-2">
        Sin conexión
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mb-6" Style="max-width: 480px;">
        No se ha podido conectar con el servidor. Comprueba tu conexión a internet e inténtalo de nuevo.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reintentar">
        Reintentar
    </MudButton>
</MudContainer>

@code {
    private void Reintentar() => Navigation.NavigateTo(Navigation.Uri, forceLoad: false);
}