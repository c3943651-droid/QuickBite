@page "/delivery-persons/{id:guid}"
@using QuickBite.AdminBlazor.Models.Delivery
@using QuickBite.AdminBlazor.Services

<PageTitle>@(Repartidor?.Nombre ?? "Repartidor") — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (Repartidor is null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">@(_error ?? "No se pudo cargar el repartidor.")</MudAlert>
    }
    else
    {
        <div class="d-flex align-center justify-space-between mb-4">
            <div class="d-flex align-center gap-3">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               Color="Color.Default"
                               title="Volver a repartidores"
                               OnClick="GoBack" />
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">@Repartidor.Nombre</MudText>
                <MudChip T="string" Size="Size.Small" Color="DeliveryStatusUi.Color(Repartidor.EstadoDisponibilidad)">
                    @DeliveryStatusUi.Display(Repartidor.EstadoDisponibilidad)
                </MudChip>
            </div>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="GoToEdit">
                Editar
            </MudButton>
        </div>

        <MudGrid Class="mb-4">
            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="rounded-lg h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Datos personales</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText></MudItem>
                            <MudItem xs="8"><MudText Typo="Typo.body2">@Repartidor.Email</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Teléfono</MudText></MudItem>
                            <MudItem xs="8"><MudText Typo="Typo.body2">@(Repartidor.Telefono ?? "—")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Vehículo</MudText></MudItem>
                            <MudItem xs="8"><MudText Typo="Typo.body2">@(Repartidor.Vehiculo ?? "—")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption" Color="Color.Secondary">Fecha de alta</MudText></MudItem>
                            <MudItem xs="8"><MudText Typo="Typo.body2">@Repartidor.FechaAlta.ToString("dd/MM/yyyy")</MudText></MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudCard Elevation="1" Class="rounded-lg text-center pa-4">
                            <MudText Typo="Typo.h3" Color="Color.Primary" Class="fw-bold">@Repartidor.EntregasCompletadas</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Entregas completadas</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudCard Elevation="1" Class="rounded-lg text-center pa-4">
                            <MudText Typo="Typo.h3" Color="Color.Primary" Class="fw-bold">@EntregasDelMes</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Entregas del mes</MudText>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudCard Elevation="1" Class="rounded-lg text-center pa-4">
                            <MudText Typo="Typo.h3" Color="Color.Primary" Class="fw-bold">@TiempoPromedioTexto</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tiempo promedio</MudText>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="1" Class="pa-4 rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-4">Historial de entregas</MudText>
            <MudTable T="AdminDeliveryHistoryItem"
                      Items="Historial"
                      RowsPerPage="10"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>Pedido</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh Class="text-right">Total</MudTh>
                    <MudTh>Entregado</MudTh>
                    <MudTh Class="text-right">Tiempo (min)</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudText Typo="Typo.body2" Class="fw-bold">@context.NumeroPedido</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2">@context.Cliente</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2" Class="text-right">@context.Total.ToString("C")</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2">@(context.EntregadoEn?.ToString("dd/MM/yyyy HH:mm") ?? "—")</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2" Class="text-right">@(context.TiempoEntregaMinutos?.ToString("0") ?? "—")</MudText></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Aún no hay entregas registradas.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>