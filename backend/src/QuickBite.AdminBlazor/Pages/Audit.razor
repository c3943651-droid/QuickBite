@page "/audit"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Audit

<PageTitle>Auditoría — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Auditoría</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Registro de acciones críticas del sistema</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadAsync" Disabled="IsLoading" Class="refresh-audit" />
    </div>

    <MudPaper Elevation="2" Class="pa-4 mb-6 rounded-lg">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Usuario" Placeholder="Buscar por nombre" @bind-Value="UsuarioFiltro" Class="filter-user" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Entidad" Placeholder="Ej: Order, Product" @bind-Value="EntidadFiltro" Class="filter-entity" />
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center justify-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="AplicarFiltros" Disabled="IsLoading" Class="btn-filtrar">
                    Filtrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (IsLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@Error</MudAlert>
    }
    else if (_filtered.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No hay registros de auditoría para los filtros aplicados.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="3" Class="pa-4 rounded-lg mb-4">
            <MudSimpleTable Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Entidad afectada</th>
                        <th>IP</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in PageRows)
                    {
                        <tr>
                            <td class="fw-bold">@row.UsuarioNombre</td>
                            <td>@row.Accion</td>
                            <td>@row.Entidad</td>
                            <td>@FormatEntityId(row.EntidadId)</td>
                            <td>@(row.IpOrigen ?? "—")</td>
                            <td>@row.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <MudIconButton Size="Size.Small" Color="Color.Primary"
                                               Icon="@(_expanded.Contains(row.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               OnClick="@(() => ToggleDetail(row.Id))"
                                               Class="btn-detail"
                                               aria-label="Ver detalle" />
                            </td>
                        </tr>
                        @if (_expanded.Contains(row.Id))
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="ml-4 mr-4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Detalles (JSON)</MudText>
                                        <pre class="info-json mt-2 pa-3 rounded-lg">@FormatDetails(row.Detalles)</pre>
                                        @if (!string.IsNullOrWhiteSpace(row.UserAgent))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Agente de usuario: @row.UserAgent</MudText>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>

        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_filtered.Count registros</MudText>
            <div class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(Page <= 1)" OnClick="GoPrev" Class="pag-prev">‹ Anterior</MudButton>
                <MudText Typo="Typo.body2" Class="mx-4 pag-info">Página @Page de @TotalPages</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(Page >= TotalPages)" OnClick="GoNext" Class="pag-next">Siguiente ›</MudButton>
            </div>
        </div>
    }
</MudContainer>