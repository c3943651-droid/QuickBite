@page "/delivery-persons"
@using QuickBite.AdminBlazor.Models.Delivery
@using QuickBite.AdminBlazor.Services

<PageTitle>Repartidores — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Repartidores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestión del equipo de reparto</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenNewDialogAsync">
            + Nuevo repartidor
        </MudButton>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudChip T="string"
                 Text="@("Todos")"
                 Variant="@TodosChipVariant"
                 Color="Color.Primary"
                 OnClick="@(() => OnEstadoChangedAsync("todos"))" />
        @foreach (var estado in DeliveryStatusUi.All)
        {
            <MudChip T="string"
                     Text="@DeliveryStatusUi.Display(estado)"
                     Variant="@EstadoChipVariant(estado)"
                     Color="DeliveryStatusUi.Color(estado)"
                     OnClick="() => OnEstadoChangedAsync(estado)" />
        }
    </div>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg mb-4">
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearchChangedAsync"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Placeholder="Buscar por nombre o email..."
                      Clearable="true"
                      FullWidth="true" />
    </MudPaper>

    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">@_error</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">
            <MudTable T="AdminDeliveryPerson"
                      Items="RepartidoresFiltrados"
                      RowsPerPage="10"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Vehículo</MudTh>
                    <MudTh Class="text-right">Entregas</MudTh>
                    <MudTh>Fecha de alta</MudTh>
                    <MudTh Class="text-right">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            <MudLink Href="@($"/delivery-persons/{context.UsuarioId}")">@context.Nombre</MudLink>
                        </MudText>
                    </MudTd>
                    <MudTd><MudText Typo="Typo.body2">@context.Email</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2">@(context.Telefono ?? "—")</MudText></MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="DeliveryStatusUi.Color(context.EstadoDisponibilidad)">
                            @DeliveryStatusUi.Display(context.EstadoDisponibilidad)
                        </MudChip>
                    </MudTd>
                    <MudTd><MudText Typo="Typo.body2">@(context.Vehiculo ?? "—")</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2" Class="text-right">@context.EntregasCompletadas</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2">@context.FechaAlta.ToString("dd/MM/yyyy")</MudText></MudTd>
                    <MudTd>
                        <div class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Default"
                                           title="Ver detalle"
                                           Size="Size.Small"
                                           OnClick="() => GoToDetail(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Default"
                                           title="Editar"
                                           Size="Size.Small"
                                           OnClick="() => GoToEdit(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Block"
                                           Color="Color.Error"
                                           title="Desactivar"
                                           Size="Size.Small"
                                           Disabled="EsInactivo(context)"
                                           OnClick="() => DeactivateAsync(context)" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No se encontraron repartidores.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>