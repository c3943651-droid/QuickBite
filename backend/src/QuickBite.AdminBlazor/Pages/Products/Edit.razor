@page "/products/{Id:guid}/edit"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Catalog
@using QuickBite.AdminBlazor.Services

<PageTitle>Editar producto — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Editar producto</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Actualiza los datos del producto</MudText>
        </div>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToList">
            Volver
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="pa-8 rounded-lg" Style="text-align: center;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Cargando producto...</MudText>
        </MudPaper>
    }
    else if (Model is null)
    {
        <MudPaper Elevation="1" Class="pa-8 rounded-lg">
            <MudText Typo="Typo.h6" Align="Align.Center">No se encontró el producto.</MudText>
            <div class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToList">
                    Volver a la lista
                </MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-6 rounded-lg">
            <EditForm Model="Model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudForm @ref="_form" @bind-IsValid="@IsValid">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Datos básicos</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                        Label="Nombre"
                                        @bind-Value="Model.Nombre"
                                        Required="true"
                                        RequiredError="El nombre es requerido."
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="decimal"
                                        Label="Precio"
                                        @bind-Value="Model.Precio"
                                        Required="true"
                                        RequiredError="El precio es requerido."
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Adornment="Adornment.Start"
                                        AdornmentText="$" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string"
                                        Label="Descripción"
                                        @bind-Value="Model.Descripcion"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid?"
                                     Label="Categoría"
                                     @bind-Value="Model.CategoriaId"
                                     Placeholder="Sin categoría"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Clearable="true">
                                @foreach (var categoria in Categorias)
                                {
                                    <MudSelectItem T="Guid?" Value="@(categoria.Id)">@categoria.Nombre</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6" Class="d-flex align-center">
                            <MudSwitch T="bool"
                                     @bind-Value="Model.Disponible"
                                     Color="Color.Success"
                                     Label="Disponible para venta" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-6" />

                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Imagen</MudText>
                    <div class="d-flex align-center gap-4">
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <MudPaper Class="pa-1 rounded-lg" Style="width: 72px; height: 72px;">
                                <MudImage Src="@Model.ImagenUrl" ObjectFit="ObjectFit.Cover" Height="64" Width="64" Class="rounded" />
                            </MudPaper>
                        }
                        <MudFileUpload T="IBrowserFile" OnFilesChanged="HandleFileSelectedAsync" Accept=".png,.jpg,.jpeg,.webp">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                         Disabled="IsUploading"
                                         StartIcon="@(IsUploading ? null : Icons.Material.Filled.UploadFile)">
                                    @if (IsUploading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate="true" />
                                        <MudText>Subiendo...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Cambiar imagen</MudText>
                                    }
                                </MudButton>
                            </ActivatorContent>
                            <SelectedTemplate Context="file">
                                @if (file is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@file.Size.ToString("N0") bytes</MudText>
                                }
                            </SelectedTemplate>
                        </MudFileUpload>
                    </div>

                    <MudDivider Class="my-6" />

                    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Stock</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?"
                                           Label="Stock actual"
                                           Value="_stockActual"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int"
                                           Label="Stock mínimo"
                                           @bind-Value="Model.StockMinimo"
                                           Min="0"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-6" />

                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Opciones personalizables</MudText>
                        <MudButton Variant="Variant.Text"
                                 Color="Color.Primary"
                                 StartIcon="@Icons.Material.Filled.Add"
                                 OnClick="AddOption">
                            Agregar opción
                        </MudButton>
                    </div>
                    @if (!Model.Opciones.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Sin opciones. Este producto no tendrá extras personalizables.
                        </MudText>
                    }
                    @foreach (var opcion in Model.Opciones)
                    {
                        <MudGrid Class="align-center">
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string"
                                            Label="Nombre de la opción"
                                            @bind-Value="opcion.Nombre"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="decimal"
                                            Label="Precio adicional"
                                            @bind-Value="opcion.PrecioAdicional"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            Adornment="Adornment.Start"
                                            AdornmentText="$" />
                            </MudItem>
                            <MudItem xs="12" sm="2">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                             Color="Color.Error"
                                             Size="Size.Small"
                                             title="Eliminar opción"
                                             aria-label="@($"Eliminar opción {opcion.Nombre}")"
                                             OnClick="() => RemoveOption(opcion)" />
                            </MudItem>
                        </MudGrid>
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">
                            @ErrorMessage
                        </MudAlert>
                    }

                    <div class="d-flex align-center justify-space-between gap-2 mt-6">
                        <MudButton Variant="Variant.Text"
                                 Color="Color.Error"
                                 StartIcon="@Icons.Material.Filled.Delete"
                                 OnClick="DeleteAsync">
                            Eliminar producto
                        </MudButton>
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Text" OnClick="GoToList">
                                Cancelar
                            </MudButton>
                            <MudButton ButtonType="ButtonType.Submit"
                                     Variant="Variant.Filled"
                                     Color="Color.Primary"
                                     Disabled="IsSaving"
                                     StartIcon="@(IsSaving ? null : Icons.Material.Filled.Save)">
                                @if (IsSaving)
                                {
                                    <MudProgressCircular Size="Size.Small" Class="me-2" Indeterminate="true" />
                                    <MudText>Guardando...</MudText>
                                }
                                else
                                {
                                    <MudText>Guardar cambios</MudText>
                                }
                            </MudButton>
                        </div>
                    </div>
                </MudForm>
            </EditForm>
        </MudPaper>
    }
</MudContainer>