@page "/products/{Id:guid}/options"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Catalog
@using QuickBite.AdminBlazor.Services

<PageTitle>Opciones de producto — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Opciones del producto</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(ProductName) ? "Cargando..." : ProductName)</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToEdit">
                Volver
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="() => OpenDialogAsync(null)">
                Nueva opción
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudPaper Elevation="1" Class="pa-8 rounded-lg">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <MudPaper Elevation="1" Class="pa-8 rounded-lg">
            <MudText Typo="Typo.body2" Color="Color.Error" Align="Align.Center">@_error</MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">
            <MudTable T="ProductOption" Items="_options" Hover="true" Striped="true" Dense="true" SortLabel="Ordenar por" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Extras personalizables</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Precio adicional</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Style="text-align: right">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                    <MudTd DataLabel="Precio adicional">@($"{context.PrecioAdicional:C}")</MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@(context.Activo ? Color.Success : Color.Error)">
                            @(context.Activo ? "Activa" : "Inactiva")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Acciones">
                        <div class="d-flex align-center justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           title="Editar"
                                           aria-label="@($"Editar opción {context.Nombre}")"
                                           OnClick="() => OpenDialogAsync(context)" />
                            <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                           Color="@(context.Activo ? Color.Warning : Color.Success)"
                                           Size="Size.Small"
                                           title="@(context.Activo ? "Desactivar" : "Activar")"
                                           aria-label="@($"Toggle opción {context.Nombre}")"
                                           OnClick="() => ToggleActivoAsync(context)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           title="Eliminar"
                                           aria-label="@($"Eliminar opción {context.Nombre}")"
                                           OnClick="() => DeleteAsync(context)" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-8">
                        Este producto no tiene opciones personalizables.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>