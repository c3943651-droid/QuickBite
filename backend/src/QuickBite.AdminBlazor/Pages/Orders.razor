@page "/orders"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Orders
@using QuickBite.AdminBlazor.Services

<PageTitle>Pedidos — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Pedidos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Gestión de pedidos de la sucursal</MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @if (IsRefreshing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Actualizado: @LastUpdated.ToString("HH:mm:ss")
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" title="Actualizar ahora" OnClick="ManualRefreshAsync" />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudChip T="string"
                 Text="@("Todos")"
                 Variant="@TodosChipVariant"
                 Color="Color.Primary"
                 OnClick="@(() => OnEstadoChangedAsync("todos"))" />
        @foreach (var estado in OrderStatusUi.All)
        {
            <MudChip T="string"
                     Text="@OrderStatusUi.Display(estado)"
                     Variant="@EstadoChipVariant(estado)"
                     Color="OrderStatusUi.Color(estado)"
                     OnClick="() => OnEstadoChangedAsync(estado)" />
        }
    </div>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Value="_search"
                              ValueChanged="OnSearchChangedAsync"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Buscar por número o cliente..."
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDateRangePicker
                                    DateRange="_rangoFechas"
                                    DateRangeChanged="OnDateRangeChangedAsync"
                                    Label="Rango de fechas"
                                    Placeholder="Desde - Hasta"
                                    Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           Value="_repartidorId"
                           ValueChanged="OnRepartidorChangedAsync"
                           Label="Repartidor"
                           Placeholder="Todos"
                           Clearable="true">
                    @foreach (var repartidor in Repartidores)
                    {
                        <MudSelectItem T="Guid?" Value="@(repartidor.UsuarioId)">@repartidor.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="d-flex align-center justify-end gap-2 mt-4 mt-sm-0">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               aria-label="Exportar CSV"
                               OnClick="ExportCsvAsync"
                               Disabled="IsExporting">
                        Exportar CSV
                    </MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg">
        <MudDataGrid T="AdminOrderListItem"
                     @ref="_grid"
                     ServerData="LoadServerData"
                     RowsPerPage="10"
                     Hover="true"
                     Striped="true"
                     Dense="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Lista de pedidos</MudText>
            </ToolBarContent>
            <Columns>
                <TemplateColumn T="AdminOrderListItem" Title="Pedido">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            <MudLink Href="@($"/orders/{context.Item.Id}")">@context.Item.NumeroPedido</MudLink>
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Cliente">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.Cliente</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Estado">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="OrderStatusUi.Color(context.Item.Estado)">
                            @OrderStatusUi.Display(context.Item.Estado)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Repartidor">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@(context.Item.Repartidor ?? "—")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Fecha">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@context.Item.CreadoEn.ToString("dd/MM/yyyy HH:mm")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Total">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="fw-bold">@($"{context.Item.Total:C}")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="AdminOrderListItem" Title="Acciones" HeaderClass="text-right">
                    <CellTemplate>
                        <div class="d-flex align-center justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           title="Ver detalle"
                                           aria-label="@($"Ver detalle {context.Item.NumeroPedido}")"
                                           OnClick="() => GoToDetail(context.Item)" />
                            <MudIconButton Icon="@Icons.Material.Filled.TwoWheeler"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           title="Asignar repartidor"
                                           aria-label="@($"Asignar repartidor {context.Item.NumeroPedido}")"
                                           OnClick="() => OpenAssignDialogAsync(context.Item)" />
                            <MudMenu Icon="Icons.Material.Filled.ArrowDropDown"
                                     Disabled="OrderStatusUi.ValidTransitions(context.Item.Estado).Count == 0"
                                     AriaLabel="@($"Cambiar estado {context.Item.NumeroPedido}")">
                                @foreach (var target in OrderStatusUi.ValidTransitions(context.Item.Estado))
                                {
                                    <MudMenuItem OnClick="() => QuickStatusChangeAsync(context.Item, target)">
                                        Cambiar a: @OrderStatusUi.Display(target)
                                    </MudMenuItem>
                                }
                            </MudMenu>
                            <MudIconButton Icon="@Icons.Material.Filled.Block"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           title="Cancelar pedido"
                                           aria-label="@($"Cancelar pedido {context.Item.NumeroPedido}")"
                                           OnClick="() => OpenCancelDialogAsync(context.Item)" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-8">
                    No hay pedidos que coincidan con los filtros.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</MudContainer>