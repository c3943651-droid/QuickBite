@page "/error"
@inject NavigationManager Navigation

<PageTitle>Error — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center min-vh-80 py-12">
    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Style="font-size: 6rem;" Class="mb-4" />
    <MudText Typo="Typo.h3" Color="Color.Error" Align="Align.Center" Class="fw-bold mb-2">
        500
    </MudText>
    <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">
        Algo salió mal
    </MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mb-6" Style="max-width: 480px;">
        Ha ocurrido un error inesperado. Inténtalo de nuevo en unos segundos.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reintentar">
        Reintentar
    </MudButton>
</MudContainer>

@code {
    private void Reintentar() => Navigation.NavigateTo(Navigation.Uri, forceLoad: false);
}