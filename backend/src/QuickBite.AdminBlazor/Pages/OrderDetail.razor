@page "/orders/{id:guid}"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Orders
@using QuickBite.AdminBlazor.Services

<PageTitle>@(Order?.NumeroPedido ?? "Pedido") — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" />
    }
    else if (Order is null)
    {
        <MudPaper Elevation="1" Class="pa-8 rounded-lg">
            <MudText Typo="Typo.body1" Color="Color.Error" Align="Align.Center" Class="mb-4">@LoadError</MudText>
            <div class="d-flex justify-center">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="GoBack">Volver a pedidos</MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <div class="d-flex align-center gap-2 mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" title="Volver" OnClick="GoBack" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">@Order.NumeroPedido</MudText>
            <MudChip T="string" Size="Size.Small" Color="OrderStatusUi.Color(Order.Estado)">
                @OrderStatusUi.Display(Order.Estado)
            </MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Creado el @Order.CreadoEn.ToString("dd/MM/yyyy HH:mm")</MudText>
        </div>

        @if (Order.Estado == "Cancelado")
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                Pedido cancelado: @(Order.MotivoCancelacion ?? "sin motivo registrado")
            </MudAlert>
        }

        <div class="d-flex flex-wrap gap-2 mb-4">
            <MudMenu Icon="Icons.Material.Filled.Edit"
                     Label="Cambiar estado"
                     Variant="Variant.Filled"
                     Color="Color.Primary"
                     Disabled="OrderStatusUi.ValidTransitions(Order.Estado).Count == 0">
                @foreach (var target in OrderStatusUi.ValidTransitions(Order.Estado))
                {
                    <MudMenuItem OnClick="() => OpenChangeStatusDialogAsync(target)">
                        Cambiar a: @OrderStatusUi.Display(target)
                    </MudMenuItem>
                }
            </MudMenu>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.TwoWheeler"
                       OnClick="OpenAssignDialogAsync">
                Asignar repartidor
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Block"
                       OnClick="OpenCancelDialogAsync"
                       Disabled="!IsCancelable">
                Cancelar pedido
            </MudButton>
        </div>

        <MudGrid>
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">Cliente</MudText>
                    <MudText Typo="Typo.body1" Class="fw-bold">@Order.ClienteNombre</MudText>
                    @if (!string.IsNullOrWhiteSpace(Order.ClienteEmail))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Order.ClienteEmail</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(Order.ClienteTelefono))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Order.ClienteTelefono</MudText>
                    }
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">Dirección de entrega</MudText>
                    <MudText Typo="Typo.body2">@Order.DireccionEntregaSnapshot</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">Repartidor</MudText>
                    @if (string.IsNullOrWhiteSpace(Order.RepartidorNombre))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin repartidor asignado</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="fw-bold">@Order.RepartidorNombre</MudText>
                        @if (!string.IsNullOrWhiteSpace(Order.RepartidorTelefono))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Order.RepartidorTelefono</MudText>
                        }
                        <MudChip T="string" Size="Size.Small" Class="mt-2" Variant="Variant.Outlined">
                            @(Order.RepartidorEstado ?? "—")
                        </MudChip>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">Resumen del pedido</MudText>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Subtotal</MudText>
                        <MudText Typo="Typo.body2">@FormatMoney(Order.Subtotal)</MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Costo de envío</MudText>
                        <MudText Typo="Typo.body2">@FormatMoney(Order.CostoEnvio)</MudText>
                    </div>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body1" Class="fw-bold">Total</MudText>
                        <MudText Typo="Typo.body1" Class="fw-bold">@FormatMoney(Order.Total)</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="1" Class="pa-4 rounded-lg mt-4">
            <MudText Typo="Typo.h6" Class="mb-3">Productos</MudText>
            <MudTable T="AdminOrderItem" Items="Order.Items" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Precio unitario</MudTh>
                    <MudTh>Cant.</MudTh>
                    <MudTh>Opciones</MudTh>
                    <MudTh>Observaciones</MudTh>
                    <MudTh Class="text-right">Subtotal</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.NombreProducto</MudTd>
                    <MudTd>@FormatMoney(context.PrecioUnitario)</MudTd>
                    <MudTd>@context.Cantidad</MudTd>
                    <MudTd>
                        @if (context.Opciones.Count == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @foreach (var opcion in context.Opciones)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">
                                    @opcion.Nombre @(opcion.PrecioAdicional > 0 ? $"(+{opcion.PrecioAdicional:C})" : "")
                                </MudChip>
                            }
                        }
                    </MudTd>
                    <MudTd>@(context.Observaciones ?? "—")</MudTd>
                    <MudTd Class="text-right">@FormatMoney(context.Subtotal)</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudGrid Class="mt-4">
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">Historial de estados</MudText>
                    @if (Order.HistorialEstados.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin registros.</MudText>
                    }
                    else
                    {
                        <div>
                            @foreach (var entry in Order.HistorialEstados)
                            {
                                <div class="d-flex align-start gap-2 mb-3">
                                    <MudChip T="string" Size="Size.Small" Color="OrderStatusUi.Color(entry.EstadoNuevo)" Class="mt-1">
                                        @OrderStatusUi.Display(entry.EstadoNuevo)
                                    </MudChip>
                                    <div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.CreadoEn.ToString("dd/MM/yyyy HH:mm")</MudText>
                                        <MudText Typo="Typo.body2">
                                            @(entry.EstadoAnterior is null ? "Pedido creado" : $"{OrderStatusUi.Display(entry.EstadoAnterior)} → {OrderStatusUi.Display(entry.EstadoNuevo)}")
                                            @if (!string.IsNullOrWhiteSpace(entry.Usuario))
                                            {
                                                <span>· @entry.Usuario</span>
                                            }
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(entry.Comentario))
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style: italic;">@entry.Comentario</MudText>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-4 rounded-lg h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">Auditoría</MudText>
                    @if (Order.Auditoria.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin registros de auditoría para este pedido.</MudText>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="true">
                            @foreach (var entry in Order.Auditoria)
                            {
                                <MudExpansionPanel Text="@($"{entry.CreadoEn.ToString("dd/MM/yyyy HH:mm")} · {entry.Accion}")"
                                                   HeaderClass="mud-text-body2"
                                                   Dense="true">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @entry.Accion @if (!string.IsNullOrWhiteSpace(entry.Usuario)) { <span>· @entry.Usuario</span> }
                                        @if (!string.IsNullOrWhiteSpace(entry.IpOrigen)) { <span>· @entry.IpOrigen</span> }
                                    </MudText>
                                    <pre class="mt-2 mb-0 rounded pa-2" style="background: #f5f5f5; font-size: 12px;">@FormatAuditJson(entry.Detalles)</pre>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>