@page "/inventory"
@attribute [Authorize]
@using QuickBite.AdminBlazor.Models.Catalog
@using QuickBite.AdminBlazor.Services

<PageTitle>Inventario — QuickBite Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="fw-bold">Inventario</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Stock actual y mínimo de la sucursal</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Fastfood" Href="products">
            Lista de productos
        </MudButton>
    </div>

    <div class="d-flex align-center gap-4 mb-4">
        <MudButtonGroup Variant="Variant.Outlined">
            <MudButton Color="@(!_soloBajo ? Color.Primary : Color.Default)"
                       OnClick="() => CambiarFiltroBajoAsync(false)">
                Todos
            </MudButton>
            <MudButton Color="@(_soloBajo ? Color.Warning : Color.Default)"
                       OnClick="() => CambiarFiltroBajoAsync(true)">
                Solo stock bajo
            </MudButton>
        </MudButtonGroup>
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="OnSearchChangedAsync"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Placeholder="Buscar por nombre..."
                      Clearable="true"
                      Class="flex-grow-1" />
    </div>

    <div class="d-flex align-center gap-4 mb-4">
        <MudPaper Elevation="1" Class="pa-4 rounded-lg text-center flex-grow-1">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">@_totalProductos</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total de productos</MudText>
        </MudPaper>
        <MudPaper Elevation="1" Class="pa-4 rounded-lg text-center flex-grow-1">
            <MudText Typo="Typo.h5" Color="@(_productosStockBajo > 0 ? Color.Warning : Color.Success)" Class="fw-bold">@_productosStockBajo</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Productos con stock bajo</MudText>
        </MudPaper>
    </div>

    <MudPaper Elevation="1" Class="pa-4 rounded-lg">
        @if (_isLoading)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_error is not null)
        {
            <MudText Typo="Typo.body1" Color="Color.Error" Align="Align.Center" Class="py-8">
                @_error
            </MudText>
        }
        else
        {
            <MudTable T="ProductListItem"
                      Items="ProductosFiltrados"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      SortLabel="Ordenar por"
                      Breakpoint="Breakpoint.Sm">
                <ColGroup>
                    <col style="width: 30%;" />
                    <col style="width: 15%;" />
                    <col style="width: 15%;" />
                    <col style="width: 15%;" />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Stock actual</MudTh>
                    <MudTh>Stock mínimo</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh/>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Producto">
                        <div class="d-flex align-center">
                            <MudAvatar Size="Size.Small" Class="mr-3">
                                @if (!string.IsNullOrEmpty(context.ImagenUrl))
                                {
                                    <MudImage Src="@context.ImagenUrl" ObjectFit="ObjectFit.Cover" Height="40" Width="40" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Small" />
                                }
                            </MudAvatar>
                            <MudText Typo="Typo.body1" Class="fw-bold">@context.Nombre</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Stock actual">
                        <MudText Typo="Typo.body2" Class="fw-bold">@StockDisplay(context.Stock)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Stock mínimo">
                        <MudText Typo="Typo.body2">@StockDisplay(context.StockMinimo)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="@(EsStockBajo(context) ? Color.Warning : Color.Success)">
                            @(EsStockBajo(context) ? "Bajo" : "OK")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <div class="d-flex align-center justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           title="Ajustar stock"
                                           aria-label="@($"Ajustar stock {context.Nombre}")"
                                           OnClick="() => OpenAdjustStockDialogAsync(context)" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-8">
                        No hay productos que coincidan con los filtros.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>