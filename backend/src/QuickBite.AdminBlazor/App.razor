@using Microsoft.AspNetCore.Components.Authorization
@using QuickBite.AdminBlazor.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <div style="display:flex; justify-content:center; align-items:center; height:100vh;">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Typo="Typo.h6" Class="ml-4" Color="Color.Primary">Verificando sesión...</MudText>
                    </div>
                </Authorizing>
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-12 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Style="font-size: 5rem;" />
                            <MudText Typo="Typo.h4" Color="Color.Error" Class="mt-4">Acceso Denegado</MudText>
                            <MudText Typo="Typo.body1" Class="mt-2">No tienes los permisos requeridos para acceder a este recurso.</MudText>
                        </MudContainer>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página no encontrada</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
